# FlowOps 构建期约定（非 Spring 配置，Java 编译期读取）
#
# 为什么需要这个文件（O-14 覆盖率门禁的前置修复）：
#   JaCoCo 按"字节码里有没有 @Generated 注解"来过滤生成代码。Lombok 生成的
#   getter/setter/构造器/builder 默认**不带**该注解，于是会被计入"未覆盖行"，
#   把分母撑大、覆盖率被严重稀释（本项目实体/DTO 全是 Lombok 数据类，稀释量极大）。
#   打开开关后 Lombok 会给生成方法打上 @lombok.Generated（CLASS 保留级别），
#   JaCoCo 的 AnnotationGeneratedFilter 按注解**简单名**匹配即可过滤掉。
#
# 可靠性说明：该过滤只影响"度量口径"，不改变任何运行时行为；且它让覆盖率
# 真正反映**手写业务代码**的覆盖情况——正是门禁想要约束的对象。
lombok.addLombokGeneratedAnnotation = true

# 停止向上冒泡：避免将来在仓库上层意外存在 lombok.config 时被覆盖，
# 让本文件的约定对 backend/ 下所有模块（含未来新模块）生效且结果可预期。
config.stopBubbling = true
