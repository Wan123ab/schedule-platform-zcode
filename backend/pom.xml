<?xml version="1.0" encoding="UTF-8"?>
<!--
  FlowOps · 智能工作流调度与监控平台 — 父 POM
  版本基线锁定见 docs/02-技术选型.md §5「版本清单（Lock File）」
  模块依赖铁律（docs/03 §1.2）：
    - flowops-common 不依赖任何业务模块
    - flowops-scheduler 与 flowops-server 互不依赖（协作只走 DB 状态 + Redis 队列，D-08）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.flowops</groupId>
  <artifactId>flowops-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>flowops-parent</name>
  <description>FlowOps · 有资源约束的 DAG 工作流调度与监控平台</description>

  <modules>
    <module>flowops-common</module>
    <module>flowops-domain</module>
    <module>flowops-executor-client</module>
    <module>flowops-server</module>
    <module>flowops-scheduler</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- docs/02 §5 版本锁定 -->
    <spring-boot.version>3.3.4</spring-boot.version>
    <mybatis-plus.version>3.5.7</mybatis-plus.version>
    <redisson.version>3.32.0</redisson.version>
    <sa-token.version>1.39.0</sa-token.version>
    <mapstruct.version>1.6.0</mapstruct.version>
    <postgresql.version>42.7.3</postgresql.version>
    <cron-utils.version>9.2.1</cron-utils.version>
    <lombok.version>1.18.34</lombok.version>
    <spring-security.version>6.3.3</spring-security.version>

    <!-- docs/02 §5 版本锁定（质量工具）：
         JaCoCo 0.8.11 起支持 Java 21 字节码（major 65），选 0.8.12 与 JDK21 基线匹配 -->
    <jacoco.version>0.8.12</jacoco.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- 内部模块 -->
      <dependency><groupId>com.flowops</groupId><artifactId>flowops-common</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.flowops</groupId><artifactId>flowops-domain</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.flowops</groupId><artifactId>flowops-executor-client</artifactId><version>${project.version}</version></dependency>

      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson-spring-boot-starter</artifactId>
        <version>${redisson.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.dev33</groupId>
        <artifactId>sa-token-spring-boot3-starter</artifactId>
        <version>${sa-token.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.dev33</groupId>
        <artifactId>sa-token-redis-jackson</artifactId>
        <version>${sa-token.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.security</groupId>
        <artifactId>spring-security-crypto</artifactId>
        <version>${spring-security.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>com.cronutils</groupId>
        <artifactId>cron-utils</artifactId>
        <version>${cron-utils.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>21</release>
            <parameters>true</parameters>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
              <!-- lombok-mapstruct-binding：让 MapStruct 看见 lombok 生成的 getter/setter -->
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>0.2.0</version>
              </path>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
          <configuration>
            <excludes>
              <exclude>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </exclude>
            </excludes>
          </configuration>
        </plugin>

        <!--
          JaCoCo（O-14 覆盖率门禁）：插件与执行期配置在这里统一锁定，父 POM 的
          <plugins> 里只声明 GA，各模块按需追加自己的 check 规则（见 flowops-server /
          flowops-scheduler 的 pom）。

          —— 排除项为什么是这三个 ——
          · FlowopsApplication：Spring Boot 启动壳，只有 main()，无业务语义
          · *ConverterImpl / *MapperImpl：MapStruct 在编译期生成的字段搬运代码，
            不是手写逻辑；"生成了多少行赋值语句"不该影响对手写代码的覆盖评价
            （转换器里手写的 default 方法如 maskFingerprint 仍在接口中，照常被统计）
          Lombok 生成物不在这里排除 —— 它们由 backend/lombok.config 的
          addLombokGeneratedAnnotation 打上 @lombok.Generated，由 JaCoCo 自身过滤，
          口径更准确（只跳生成方法，类里手写的方法仍被统计）。
        -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <configuration>
            <excludes>
              <!--
                末尾的 * 不能省：同一份 excludes 会喂给两个**不同匹配域**——
                  · prepare-agent：按 VM 类名匹配（com/flowops/.../FooConverterImpl，无 .class）
                  · report       ：按 class 文件路径匹配（.../FooConverterImpl.class）
                只写 **/*ConverterImpl 时前者命中、后者落空，现象是"生成物明明排除了，
                却照样出现在覆盖率报告里压着分母"（2026-10-07 实测发现）。
                补一个尾 * 同时覆盖两种形态，而不是给两个 goal 各写一套。
              -->
              <exclude>**/FlowopsApplication*</exclude>
              <exclude>**/*ConverterImpl*</exclude>
              <exclude>**/*MapperImpl*</exclude>
            </excludes>
          </configuration>
          <executions>
            <execution>
              <id>jacoco-prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>jacoco-report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- 全模块统一采集 + 出报告（report 落在各模块 target/site/jacoco/）。
           门禁规则（check）刻意**不**在这里 —— 各模块阈值不同且需要显式声明生效范围，
           集中写会让人分不清"哪些模块真的被卡"，故下沉到模块 pom。 -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
