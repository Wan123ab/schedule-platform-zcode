<?xml version="1.0" encoding="UTF-8"?>
<!--
  FlowOps · 智能工作流调度与监控平台 — 父 POM
  版本基线锁定见 docs/02-技术选型.md §5「版本清单（Lock File）」
  模块依赖铁律（docs/03 §1.2）：
    - flowops-common 不依赖任何业务模块
    - flowops-scheduler 与 flowops-server 互不依赖（协作只走 DB 状态 + Redis 队列，D-08）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.flowops</groupId>
  <artifactId>flowops-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>flowops-parent</name>
  <description>FlowOps · 有资源约束的 DAG 工作流调度与监控平台</description>

  <modules>
    <module>flowops-common</module>
    <module>flowops-domain</module>
    <module>flowops-executor-client</module>
    <module>flowops-server</module>
    <module>flowops-scheduler</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- docs/02 §5 版本锁定 -->
    <spring-boot.version>3.3.4</spring-boot.version>
    <mybatis-plus.version>3.5.7</mybatis-plus.version>
    <redisson.version>3.32.0</redisson.version>
    <sa-token.version>1.39.0</sa-token.version>
    <mapstruct.version>1.6.0</mapstruct.version>
    <postgresql.version>42.7.3</postgresql.version>
    <cron-utils.version>9.2.1</cron-utils.version>
    <lombok.version>1.18.34</lombok.version>
    <spring-security.version>6.3.3</spring-security.version>

    <!-- docs/02 §5 版本锁定（质量工具）：
         JaCoCo 0.8.11 起支持 Java 21 字节码（major 65），选 0.8.12 与 JDK21 基线匹配 -->
    <jacoco.version>0.8.12</jacoco.version>

    <!--
      byte-buddy-agent 版本 —— **必须与 Spring Boot BOM 里 byte-buddy.version 一致**。
      为什么不直接引用 BOM 的属性：本 POM 是以 `<scope>import</scope>` 引入
      spring-boot-dependencies（无 parent），**BOM 的 <properties> 不会被继承**，
      `${byte-buddy.version}` 在 import 场景下取不到值，只能在此复述一份。
      升级 Spring Boot 时须同步核对此处（CI 的 green run 会打印真实解析版本，可比对）。

      它为什么必须存在：Mockito 5 的 inline mock maker 需要把 byte-buddy-agent 挂到
      JVM 上。默认做法是**运行期动态 self-attach**（`ByteBuddyAgent.installExternal`），
      该机制在 JDK 里已被标记为将来会移除；实测在 GitHub Actions 新镜像
      ubuntu24/20261004.327 上直接失败（见 <build> 中 surefire argLine 的说明）。
      现在改为**启动期显式 -javaagent**，路径由本属性拼出，故两处必须同版本。
    -->
    <byte-buddy.version>1.14.19</byte-buddy.version>

    <!--
      默认生命周期插件的版本必须显式钉死（质量工具）：
      本 POM 无 parent，且 BOM 的 import 只带 dependencyManagement ——
      **BOM 的 <pluginManagement> 同样不会被继承**。于是 clean/resources/jar/surefire
      这些被默认生命周期绑定的插件全都"无版本声明"，Maven 只能去**仓库元数据里解析
      release 最新版**（现象：mvn -o 离线构建会报
      "Error resolving version for plugin … Plugin not found in any plugin repository"，
      而联网构建又会在某天悄悄升到新版本 —— CI 与本地因此可以不一致）。
      下面钉的是当前实际解析到的版本，与本地仓库现有版本一致，离线构建不受影响。
      maven-compiler-plugin 已在 pluginManagement 中钉 3.13.0，不重复。
    -->
    <surefire.version>3.2.5</surefire.version>
    <maven-clean-plugin.version>3.2.0</maven-clean-plugin.version>
    <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
    <maven-jar-plugin.version>3.4.1</maven-jar-plugin.version>
  </properties>

  <dependencies>
    <!--
      显式声明 byte-buddy-agent（test）——不是为了在测试代码里用它，而是为了让
      surefire 的 `-javaagent:<本地仓库路径>` 在所有模块都解析得到：
      · 它是 mockito-core 的传递依赖，但"某个模块恰好没引 mockito"时本地仓库里
        就可能没有这个 jar，`-javaagent` 会以"打不开 jar"的形式炸在 JVM 启动阶段；
      · 声明在这里 = 版本与上面的 <byte-buddy.version> 同源，
        agent 与运行时 byte-buddy 版本错配（只有运行期才发作）也就无从发生。
    -->
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy-agent</artifactId>
      <version>${byte-buddy.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- 内部模块 -->
      <dependency><groupId>com.flowops</groupId><artifactId>flowops-common</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.flowops</groupId><artifactId>flowops-domain</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.flowops</groupId><artifactId>flowops-executor-client</artifactId><version>${project.version}</version></dependency>

      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson-spring-boot-starter</artifactId>
        <version>${redisson.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.dev33</groupId>
        <artifactId>sa-token-spring-boot3-starter</artifactId>
        <version>${sa-token.version}</version>
      </dependency>
      <dependency>
        <groupId>cn.dev33</groupId>
        <artifactId>sa-token-redis-jackson</artifactId>
        <version>${sa-token.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.security</groupId>
        <artifactId>spring-security-crypto</artifactId>
        <version>${spring-security.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>com.cronutils</groupId>
        <artifactId>cron-utils</artifactId>
        <version>${cron-utils.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!--
          默认生命周期插件的版本钉子（理由见 properties 中"surefire.version"上方注释）。
          少了这几条，`mvn -o` 会在父 POM 处直接失败：显式在 <plugins> 里声明的插件
          必须能解析出版本，而离线时读不到仓库元数据。
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>21</release>
            <parameters>true</parameters>
            <annotationProcessorPaths>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
              <!-- lombok-mapstruct-binding：让 MapStruct 看见 lombok 生成的 getter/setter -->
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>0.2.0</version>
              </path>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
          <configuration>
            <excludes>
              <exclude>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
              </exclude>
            </excludes>
          </configuration>
        </plugin>

        <!--
          JaCoCo（O-14 覆盖率门禁）：插件与执行期配置在这里统一锁定，父 POM 的
          <plugins> 里只声明 GA，各模块按需追加自己的 check 规则（见 flowops-server /
          flowops-scheduler 的 pom）。

          —— 排除项为什么是这三个 ——
          · FlowopsApplication：Spring Boot 启动壳，只有 main()，无业务语义
          · *ConverterImpl / *MapperImpl：MapStruct 在编译期生成的字段搬运代码，
            不是手写逻辑；"生成了多少行赋值语句"不该影响对手写代码的覆盖评价
            （转换器里手写的 default 方法如 maskFingerprint 仍在接口中，照常被统计）
          Lombok 生成物不在这里排除 —— 它们由 backend/lombok.config 的
          addLombokGeneratedAnnotation 打上 @lombok.Generated，由 JaCoCo 自身过滤，
          口径更准确（只跳生成方法，类里手写的方法仍被统计）。
        -->
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <configuration>
            <excludes>
              <!--
                末尾的 * 不能省：同一份 excludes 会喂给两个**不同匹配域**——
                  · prepare-agent：按 VM 类名匹配（com/flowops/.../FooConverterImpl，无 .class）
                  · report       ：按 class 文件路径匹配（.../FooConverterImpl.class）
                只写 **/*ConverterImpl 时前者命中、后者落空，现象是"生成物明明排除了，
                却照样出现在覆盖率报告里压着分母"（2026-10-07 实测发现）。
                补一个尾 * 同时覆盖两种形态，而不是给两个 goal 各写一套。
              -->
              <exclude>**/FlowopsApplication*</exclude>
              <exclude>**/*ConverterImpl*</exclude>
              <exclude>**/*MapperImpl*</exclude>
            </excludes>
          </configuration>
          <executions>
            <execution>
              <id>jacoco-prepare-agent</id>
              <goals>
                <goal>prepare-agent</goal>
              </goals>
            </execution>
            <execution>
              <id>jacoco-report</id>
              <phase>verify</phase>
              <goals>
                <goal>report</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- 全模块统一采集 + 出报告（report 落在各模块 target/site/jacoco/）。
           门禁规则（check）刻意**不**在这里 —— 各模块阈值不同且需要显式声明生效范围，
           集中写会让人分不清"哪些模块真的被卡"，故下沉到模块 pom。 -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
      </plugin>

      <!--
        surefire：把 byte-buddy-agent 从"运行期动态 attach"改成"JVM 启动期显式挂载"。

        —— 为什么必须改 ——
        Mockito 5 默认用 inline mock maker，它需要 byte-buddy-agent 提供的
        Instrumentation。Mockito 的默认策略是**运行期 self-attach**：JVM 起来之后
        再去 attach 自己（ByteBuddyAgent.installExternal）。这条路径依赖 JDK 的
        dynamic attach，而 JDK 已明确警告"If a serviceability tool is in use…"、
        "self-attaching … will no longer work in future releases of the JDK"。

        实测（2026-10-07，CI run #13）：
          · run #12 / #14（镜像 ubuntu24/20260927.320）绿：日志里有
            "WARNING: … -XX:+EnableDynamicAgentLoading" —— 动态 attach 成功
          · run #13（镜像 ubuntu24/20261004.327）**红**：同一份代码，日志里该警告
            完全消失，取而代之的是 JVM 级断言
              *** java.lang.instrument ASSERTION FAILED ***:
                  "success" with message createInstrumentationImpl failed
                  at src/java.instrument/share/native/libinstrument/InvocationAdapter.c line: 425
              Agent failed to start!
            → IdGenTest 6 例全挂在 Mockito 初始化（MockMaker 加载不了）

        结论：**不是随机抖动，是"测试依赖了 JDK 即将移除的动态 attach 机制"**，
        环境一换就必然暴露。改法沿用官方建议（mockito#3037）：用 -javaagent 在启动期
        就把 agent 挂上，ByteBuddyAgent.install() 会直接复用，从此不再走 dynamic attach。
        注意这不是"绕过"——启动期 -javaagent 正是 JaCoCo agent 走的那条路，
        而它在 run #13 里是正常工作的（失败的只有动态 attach 那一条）。

        @{argLine} 不能省：JaCoCo 的 prepare-agent 把参数写在 argLine **属性**里，
        这里用 surefire 的 late-property 语法 @{...} 追加而不是覆盖，
        否则 JaCoCo 的 -javaagent 会被顶掉、覆盖率报告静默变空。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy.version}/byte-buddy-agent-${byte-buddy.version}.jar</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
