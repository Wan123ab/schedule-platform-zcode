<?xml version="1.0" encoding="UTF-8"?>
<!-- 应用层：全部 REST 接口 + WebSocket（M1）+ 六域业务（docs/01 §3.2）。
     无状态、多副本；Flyway 迁移只在本模块执行（scheduler 关闭 flyway）。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.flowops</groupId>
    <artifactId>flowops-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>flowops-server</artifactId>
  <name>flowops-server</name>

  <dependencies>
    <dependency>
      <groupId>com.flowops</groupId>
      <artifactId>flowops-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.flowops</groupId>
      <artifactId>flowops-domain</artifactId>
    </dependency>
    <!-- 节点连通性测试（docs/07 §5.4 的 schedule:node:test）需要一次真实 SSH 握手。
         executor-client 是纯客户端库（只依赖 common + jsch），不含 Spring/DB 耦合，
         故 server 直接复用它，而不是在 server 里另写一份 SSH 逻辑。
         D-08 约束的是 server ✗ scheduler，此处不涉及。 -->
    <dependency>
      <groupId>com.flowops</groupId>
      <artifactId>flowops-executor-client</artifactId>
    </dependency>

    <!-- 会话（D-06）：Sa-Token + Redis 存储 -->
    <dependency>
      <groupId>cn.dev33</groupId>
      <artifactId>sa-token-spring-boot3-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>cn.dev33</groupId>
      <artifactId>sa-token-redis-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- 切面（docs/03 §3.3：@Audited/@RequiresPermission/@DataScope/@Idempotent 四切面）
         与 WebSocket 日志通道（D-10 / docs/07 §7.5） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>

    <!-- 迁移（docs/05 §7.5）：Flyway 10 对 PG 需要 database 模块 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- 密码 BCrypt（docs/05 app_user.password_hash） -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!-- 可观测（docs/02 §1.8 / 08 §3.2：暴露 /actuator/prometheus） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- 对象转换（docs/07 §8.3：编译期生成 + unmappedTargetPolicy=ERROR 防漏字段） -->
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.3.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!--
        JaCoCo 门禁（O-14）。版本与 prepare-agent/report 由父 POM 统一管理，
        这里只追加两条 check 规则 —— 为什么是两条而不是一条：

        ① 逻辑层门禁（真门禁）：只统计 service / scope / manager 三类包。
           这三类是"用单元测试就应当测到"的业务逻辑，覆盖率数字在这里才有意义。
           为什么不把 controller / aspect / ws 一起纳进来：它们的行为（HTTP 绑定、
           切面织入、WebSocket 会话）在单元测试里只能靠"调用一次然后断言没抛异常"
           来凑数，那是在制造假覆盖。它们应由 MockMvc / @SpringBootTest 集成测试
           覆盖 —— 即 README-M2 登记的 O-9，做完后可以再往上加规则。

        ② 模块地板（防倒退）：整体 LINE ≥ 30%，其唯一目的是"不许整模块倒退"，
           不代表 30% 是质量目标。

        ⚠️ 触线时的正确处理：优先补测试。确需调整阈值，必须在本文件写明理由并同步
        更新 README-M2/M3 的偏离登记 —— 不允许悄悄删规则或调数字。
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-check-logic-layer</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <includes>
                <include>**/service/*</include>
                <include>**/scope/*</include>
                <include>**/manager/*</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <!-- 基线 57.8%（2026-10-07 实测）。留约 3pt 余量：
                           本轮 M3 新增的算子域 Service 会带测试进来，不会被这条卡住；
                           而 task.service / auth.service 两个 M1 遗留 0% 包已被登记为待补，
                           它们只会拖低这条线 —— 这正是期望的摩擦 -->
                      <minimum>0.55</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>jacoco-check-module-floor</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <!-- 基线 32.9%（2026-10-07 实测），仅作防倒退地板 -->
                      <minimum>0.30</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
