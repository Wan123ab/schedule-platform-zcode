<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 算子输出声明自定义 SQL（docs/05 §3.3 operator_output_decl，R10）。 -->
<mapper namespace="com.flowops.domain.mapper.asset.OperatorOutputDeclMapper">

    <delete id="deleteByVersionId">
        DELETE FROM operator_output_decl WHERE operator_version_id = #{operatorVersionId}
    </delete>

    <select id="listByVersionId" resultType="com.flowops.domain.entity.asset.OperatorOutputDecl">
        SELECT * FROM operator_output_decl
         WHERE operator_version_id = #{operatorVersionId}
         ORDER BY seq, id
    </select>

    <!-- 批量取（DAG 规则 4 的"变量是否已声明"判定）；空集合由调用方短路。 -->
    <select id="listByVersionIds" resultType="com.flowops.domain.entity.asset.OperatorOutputDecl">
        SELECT * FROM operator_output_decl
         WHERE operator_version_id IN
        <foreach collection="operatorVersionIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
         ORDER BY operator_version_id, seq, id
    </select>

</mapper>
