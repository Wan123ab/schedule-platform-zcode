<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 算子输出声明自定义 SQL（docs/05 §3.3 operator_output_decl，R10）。 -->
<mapper namespace="com.flowops.domain.mapper.asset.OperatorOutputDeclMapper">

    <delete id="deleteByVersionId">
        DELETE FROM operator_output_decl WHERE operator_version_id = #{operatorVersionId}
    </delete>

    <select id="listByVersionId" resultType="com.flowops.domain.entity.asset.OperatorOutputDecl">
        SELECT * FROM operator_output_decl
         WHERE operator_version_id = #{operatorVersionId}
         ORDER BY seq, id
    </select>

</mapper>
