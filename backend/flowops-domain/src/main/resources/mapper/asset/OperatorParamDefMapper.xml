<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 算子参数定义自定义 SQL（docs/05 §3.3 operator_param_def，R9）。 -->
<mapper namespace="com.flowops.domain.mapper.asset.OperatorParamDefMapper">

    <!-- 替换式更新（先删后插）：草稿版本编辑时整包替换，避免"先插入后删除"中途撞 uk_param_def_key -->
    <delete id="deleteByVersionId">
        DELETE FROM operator_param_def WHERE operator_version_id = #{operatorVersionId}
    </delete>

    <select id="listByVersionId" resultType="com.flowops.domain.entity.asset.OperatorParamDef">
        SELECT * FROM operator_param_def
         WHERE operator_version_id = #{operatorVersionId}
         ORDER BY seq, id
    </select>

    <!-- 批量取（DAG 校验装配）：一次 IN 查询换掉 N 次单版本查询。
         调用方负责按 operator_version_id 分组；空集合直接短路，避免拼出 IN ()。 -->
    <select id="listByVersionIds" resultType="com.flowops.domain.entity.asset.OperatorParamDef">
        SELECT * FROM operator_param_def
         WHERE operator_version_id IN
        <foreach collection="operatorVersionIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
         ORDER BY operator_version_id, seq, id
    </select>

    <!-- 只改默认值一列：试运行「另存为默认值」。
         刻意不写 UPDATE operator_param_def SET ... 的整行更新 —— 版本发布后
         key/类型/必填/敏感 这些结构字段必须原样冻结（D-11），一个"顺手带上的整行更新"
         就是冻结失效的入口。驼峰列名由 mybatis 的 map-underscore-to-camel-case 负责读侧，
         写侧一律显式写列名。 -->
    <update id="updateDefaultValue">
        UPDATE operator_param_def
           SET default_value = #{defaultValue}
         WHERE operator_version_id = #{operatorVersionId}
           AND param_key = #{paramKey}
    </update>

</mapper>
