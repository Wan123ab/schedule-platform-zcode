<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 凭据域自定义 SQL。引用计数实时校验是删除闸门的唯一权威（docs/05 §6.3）。 -->
<mapper namespace="com.flowops.domain.mapper.asset.CredentialMapper">

    <select id="countReferences" resultType="long">
        SELECT count(*)
          FROM executor_node
         WHERE credential_ref_id = #{credentialId}
           AND deleted = false
    </select>

</mapper>
