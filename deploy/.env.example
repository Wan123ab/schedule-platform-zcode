# FlowOps 部署环境变量（复制为 .env 后修改；.env 禁止入库）
# 一键启动：docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d

# ── PostgreSQL ────────────────────────────────────────
DB_NAME=flowops
DB_USER=flowops
DB_PASSWORD=change_me_flowops
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────
REDIS_PORT=6379

# ── 凭据主密钥（M-06：缺失则 server 拒绝启动）─────────
# 生成示例：openssl rand -base64 32
FLOWOPS_CRED_MASTER_KEY=

# ── 端口 ──────────────────────────────────────────────
SERVER_PORT=8080
WEB_PORT=80
